# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle and Android build outputs
.gradle/
build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# Keep the Gradle wrapper jar, which the *.jar rule above would otherwise ignore
!gradle/wrapper/gradle-wrapper.jar

.DS_Store